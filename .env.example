# Operator credentials stay on the server. Generate a strong, unique password.
KC_BOOTSTRAP_ADMIN_USERNAME=admin
KC_BOOTSTRAP_ADMIN_PASSWORD=

# Supply your own licence email and personal acceptance of https://tide.org/legal.
TIDE_LICENSE_EMAIL=
TIDE_TERMS_ACCEPTED=
APP_ORIGIN=http://localhost:3000

# Local inference; no model is downloaded automatically.
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3-vl:2b-instruct

# Optional: DNS server for this container only, if Docker's default DNS does not work.
# TIDECLOAK_DNS=
# Keep TideCloak's default sign-in design.
BRAND_SKIP=1
BRAND_ACCENT=3d6655

# Published Chrome Web Store listing URL. Leave empty until a listing exists.
MARGIN_CHROME_STORE_URL=

# Published Mozilla Add-ons listing. Leave empty until approved.
MARGIN_FIREFOX_STORE_URL=
